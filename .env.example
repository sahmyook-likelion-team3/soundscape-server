# 배포 환경에서 사용할 환경변수 템플릿.
# 실제 값을 채운 뒤 .env 로 복사해서 사용한다 (.env 는 git에 커밋되지 않음).

SPRING_PROFILES_ACTIVE=prod

# ---------- MySQL ----------
DB_HOST=
DB_PORT=3306
DB_NAME=soundscape
DB_USERNAME=soundscape
DB_PASSWORD=

# ---------- AWS S3 ----------
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# ---------- OpenAI ----------
OPENAI_API_KEY=

# ---------- CORS ----------
# 콤마로 여러 origin 구분 가능 (예: https://soundscape.app,https://admin.soundscape.app)
CORS_ALLOWED_ORIGINS=

# ---------- 운영용 관리자 API ----------
# POST /api/v1/admin/music/reload 호출 시 X-Admin-Key 헤더로 전달해야 하는 값. 비워두면 항상 거부됨.
ADMIN_API_KEY=
